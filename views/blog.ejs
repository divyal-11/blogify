<!DOCTYPE html>
<html lang="en">

<head>
    <%- include('partials/head') %>
        <title>Blog Details</title>
</head>

<body>
    <%- include('partials/nav') %>

    <div class="container mt-4">
        <h1><%= blog.title %></h1>
        <% if (blog.coverImageURL) { %>
            <img src="<%= blog.coverImageURL %>" class="img-fluid rounded my-3" style="max-height: 450px; object-fit: cover;">
        <% } %>
        <p class="mt-4 fs-5" style="white-space: pre-wrap; line-height: 1.8;"><%= blog.content %></p>
    </div>

    <div class="container mt-4 d-flex align-items-center">
        <img src="<%= blog.createdBy.profileImageURL %>" width="50px" height="50px" class="rounded-circle me-3" style="object-fit: cover;">
        <div>
            <h6 class="mb-0 fw-bold"><%= blog.createdBy.fullName %></h6>
            <small class="text-muted">Published on <%= locals.formattedDate %></small>
        </div>
    </div>

    
    

    <div class="container mt-4">
        <% if(locals.user) { %>
            <form action="/blog/comment/<%= blog._id %>" method="POST">
                <div class="mb-3">
                    <label for="content">Comments(<%= comments.length %>)</label>
                    <textarea class="form-control" id="content" name="content"></textarea>
                </div>
                <button type="submit" class="btn btn-primary">Add Comment</button>
            </form>
        <% } else { %>
            <a href="/user/signin">Login to comment</a>
        <% } %>

        <% if (comments.length > 0) { %>
    <% comments.forEach(comment => { %>
        <div class="mt-3 p-3 border rounded">
    <div class="d-flex align-items-center mb-2">
        <img src="<%= comment.createdBy.profileImageURL %>" width="35px" height="35px" class="rounded-circle me-2" style="object-fit: cover;">
        <strong><%= comment.createdBy.fullName %></strong>
    </div>
    <pre class="mb-0 ms-4"><%= comment.content %></pre>
</div>

    <% }) %>
<% } else { %>
    <p class="text-muted mt-3">No comments yet.</p>
<% } %>

    </div>
    


    <%- include('partials/scripts') %>
    
</body>
</html>